<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/SheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sheet_title" />

        <!-- 规模 -->
        <TextView
            style="@style/SheetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sheet_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderN"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/sheet_size"
                android:stepSize="1"
                android:value="8"
                android:valueFrom="2"
                android:valueTo="24" />

            <TextView
                android:id="@+id/valN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:minWidth="28dp"
                android:text="8"
                android:textColor="@color/amber"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:tag="3"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3×3"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="5"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5×5"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="6"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6×6"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="8"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8×8"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="10"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10×10"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="12"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12×12"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="16"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16×16"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="20"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20×20"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="24"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24×24"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 亮灯比例 -->
        <TextView
            style="@style/SheetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sheet_ratio" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRatio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/sheet_ratio"
                android:stepSize="1"
                android:value="10"
                android:valueFrom="1"
                android:valueTo="60" />

            <TextView
                android:id="@+id/valRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:minWidth="40dp"
                android:text="10%"
                android:textColor="@color/amber"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsRatio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:tag="5"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5%"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="10"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10%"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="20"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20%"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="30"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30%"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="50"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 自动求解速度 -->
        <TextView
            style="@style/SheetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sheet_speed" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/sheet_speed"
                android:stepSize="20"
                android:value="220"
                android:valueFrom="40"
                android:valueTo="1000" />

            <TextView
                android:id="@+id/valSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:minWidth="56dp"
                android:text="220ms"
                android:textColor="@color/amber"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:tag="40"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="极速"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="120"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快速"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="260"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中速"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="600"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="慢速"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />

            <com.google.android.material.chip.Chip
                android:tag="1000"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="演示"
                android:textColor="@color/ink_dim"
                app:chipBackgroundColor="@color/surface_variant" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCountTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/sheet_count_target"
            android:textColor="@color/ink_dim"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#1FFFFFFF" />

        <!-- 统计 -->
        <TextView
            style="@style/SheetSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sheet_stats_title" />

        <LinearLayout
            android:id="@+id/statsTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCsv"
                style="@style/WgtButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/sheet_export_csv"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearSize"
                style="@style/WgtButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/sheet_clear_size"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearAll"
                style="@style/WgtButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="0dp"
                android:text="@string/sheet_clear_all"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
